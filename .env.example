# Public URL of web app (used in metadata/share links)
NEXT_PUBLIC_SITE_URL=https://example.com

# Host port for web container
WEB_PORT=80

# Internal service URL
BOT_SENDER_URL=http://bot-sender:3001

# Required secrets
INTERNAL_HMAC_SECRET=replace_with_long_random_secret
RECAPTCHA_SECRET=replace_with_recaptcha_secret
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace_with_recaptcha_site_key
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token

# Comma-separated Telegram chat IDs
RECIPIENT_USER_IDS=473779853

# Optional debug endpoint toggle for bot-sender
ENABLE_DEBUG_ENDPOINTS=false
